{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "widen",
  "packageRules": [
    {
      "description": "Composer constraint changes reach users: release them (fix:)",
      "matchManagers": [
        "composer"
      ],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "description": "CI-only updates: no release",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "automerge": true,
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ]
    }
  ]
}
